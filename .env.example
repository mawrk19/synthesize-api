APP_NAME=EES
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Client-facing debug (API error detail, agent prompts). Falls back to APP_DEBUG if unset.
# Set false in production so users cannot read stack traces / provider payloads.
SYNTHESIZE_DEBUG=true
APP_URL=http://localhost:8000

# Vercel frontend URL (used in emails/links; set in production)
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API (Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production (Neon): pgsql + DB_URL or DATABASE_URL
DB_CONNECTION=pgsql
DB_PORT=5432
DB_SSLMODE=require
# DB_URL=postgresql://user:pass@host/neondb?sslmode=require
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Local uploads: local. Production on Render: s3 (AWS S3 or Cloudflare R2)
FILESYSTEM_DISK=local
UPLOADS_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / Cloudflare R2 (required when UPLOADS_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2 example: AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenAI-compatible AI (optional — empty key uses local SRS fallback)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Audio transcription (Groq free-tier Whisper). Defaults to AI_API_KEY + AI_BASE_URL when unset.
# AI_TRANSCRIPTION_API_KEY=
# AI_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Agent pipeline / GitHub (Developer agent)
GITHUB_DEFAULT_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
PIPELINE_MAX_TASKS_PER_RUN=10
PIPELINE_TICK_DELAY_SECONDS=5

# Set true on Render to seed roles/users on deploy (idempotent)
SEED_ON_DEPLOY=false
